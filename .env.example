GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MILVUS_DB_PATH=./data/milvus.db
COLLECTION_NAME=docs_rag
DOCS_DIR=./docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Browser origins allowed to call the API from another domain (comma-separated).
# Leave empty when the frontend is served by FastAPI or the Vite proxy.
CORS_ORIGINS=

# Voice (optional): leave the key empty to disable voice
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Voice for spoken replies. Some English Aura-2 voices (full list:
# https://developers.deepgram.com/docs/tts-models):
#   aura-2-thalia-en    feminine, American (default)
#   aura-2-asteria-en   feminine, American
#   aura-2-luna-en      feminine, American, young adult
#   aura-2-athena-en    feminine, American, mature
#   aura-2-apollo-en    masculine, American
#   aura-2-orion-en     masculine, American
#   aura-2-atlas-en     masculine, American, mature
#   aura-2-draco-en     masculine, British
#   aura-2-pandora-en   feminine, British
#   aura-2-hyperion-en  masculine, Australian
#   aura-2-theia-en     feminine, Australian
# Restart the backend after changing it (--reload doesn't watch .env).
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_KEYTERMS=
