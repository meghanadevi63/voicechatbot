GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

MILVUS_DB_PATH=./data/milvus.db
COLLECTION_NAME=docs_rag
DOCS_DIR=./docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Browser origins allowed to call the API from another domain (comma-separated).
# Leave empty when the frontend is served by FastAPI or the Vite proxy.
CORS_ORIGINS=

# Voice (optional): leave the key empty to disable voice
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_KEYTERMS=
